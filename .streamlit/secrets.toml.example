# Copy this file to .streamlit/secrets.toml and fill in your real values.
# On Streamlit Community Cloud, paste the same keys into
# App settings → Secrets instead of committing this file.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
ADMIN_PASSWORD = "choose-something-only-you-know"
